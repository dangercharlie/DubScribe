<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: allow audio input -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- No sandboxing: required for CGEventTap global key monitoring and SMAppService -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Temporary exception: allows reading/writing outside sandbox (needed without sandbox) -->
	<!-- com.apple.security.temporary-exception.files.home-relative-path.read-write not needed without sandbox -->

	<!-- Hardened runtime: JIT not needed -->
	<!-- Hardened runtime: unsigned executable memory not needed -->
</dict>
</plist>
