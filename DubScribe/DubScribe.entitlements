<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: allow audio input -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- No sandboxing. Required for two things:
	     (a) SMAppService login-item registration, and
	     (b) writing clips to a user-visible location and moving expired ones to
	         the Trash via FileManager.trashItem.

	     Note: this is NOT about global key monitoring. Global shortcuts use
	     Carbon RegisterEventHotKey, which deliberately needs no Accessibility
	     permission and installs no event tap. An earlier comment here claimed
	     CGEventTap was required; that was stale. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
